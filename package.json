{
  "name": "baklava",
  "version": "0.0.1",
  "description": "The unified developer console for the modern stack. Federated queries across Postgres, Mongo, Redis, Kafka, Docker, K8s. Resource graph + AI plan + plugin SDK.",
  "license": "MIT",
  "author": "eren <erenaltan@gmail.com>",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "baklava": "tsx bin/baklava.ts",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "demo": "tsx bin/baklava.ts --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder — eslint config arrives with the Next.js scaffold'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "ai": "^6.0.174",
    "better-sqlite3": "^12.9.0",
    "duckdb": "^1.1.3",
    "next": "^16.2.4",
    "node-sql-parser": "^5.3.6",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
